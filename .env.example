# Copy this file to .env and fill in your key. .env must never go to git.
# Any OpenAI-compatible provider works. The defaults below are for Groq (free tier, no credit card):
# create a key at https://console.groq.com/keys

LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
# Reasoning effort for reasoning models (low/medium/high); leave empty for models that do not support it.
LLM_REASONING_EFFORT=low

# Optional: a vision model to read the whiteboard and photos (empty = image reading off).
LLM_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# Optional: server speech-to-text (empty = the browser's own speech recognition).
STT_MODEL=whisper-large-v3-turbo
# Optional: server text-to-speech (empty = the browser's speech synthesis).
TTS_MODEL=
TTS_VOICE=alloy

# --- Other providers (change the three lines above) ---
# Google Gemini: LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/  LLM_MODEL=gemini-2.5-flash  LLM_REASONING_EFFORT=
# OpenRouter:    LLM_BASE_URL=https://openrouter.ai/api/v1  LLM_MODEL=<a model id ending in :free>
# OpenAI:        LLM_BASE_URL=  LLM_MODEL=<model id>

# auto = use the model when a key is present, otherwise offline rules. offline = always rules.
BUDDY_MODE=auto
# 0 = the buddy only uses the drafts written in code (one model call less per message).
BUDDY_REPHRASE=1

# Public demo protection
RATE_LIMIT_PER_MINUTE=12
DAILY_LLM_CALLS=600

# Minimum sessions below which the teacher does not see the data.
BUDDY_MIN_SESSIONS=10
