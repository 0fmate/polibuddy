# Copy this file to .env and add your key (.env must never go to git).
OPENAI_API_KEY=

# OpenAI model for the interpreter and the buddy's lines.
BUDDY_MODEL=gpt-6-luna

# Reasoning effort: low for the interpreter, none for the buddy's lines (faster). "off" if the model does not support it.
BUDDY_REASONING_EFFORT=low
BUDDY_REASONING_EFFORT_COMPAGNO=none

# Voice: speech-to-text model, text-to-speech model and voice.
BUDDY_STT_MODEL=gpt-4o-mini-transcribe
BUDDY_TTS_MODEL=gpt-4o-mini-tts
BUDDY_VOICE=coral

# auto = use the model when a key is present, otherwise offline rules. offline = always rules.
BUDDY_MODE=auto

# 0 = the buddy only uses the drafts written in code (faster, one call less per message).
BUDDY_RIFORMULA=1

# Minimum sessions below which the teacher does not see the data.
BUDDY_SOGLIA=10
